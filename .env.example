# ==============================================================================
# Student Care Platform — Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to '.env' for local development.
# NEVER commit real credentials, passwords, tokens, or private keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Service Runtime & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_HOST=0.0.0.0
DEFAULT_TIMEZONE=Asia/Colombo
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. Central Control Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Used for school registry, global school IDs, routing catalog, and migration tracking.
# In local development, you can point to a local PostgreSQL instance.
CONTROL_DB_HOST=localhost
CONTROL_DB_PORT=5432
CONTROL_DB_NAME=student_care_control
CONTROL_DB_USER=postgres
CONTROL_DB_PASSWORD=your_local_control_db_password
CONTROL_DB_SSL=false
CONTROL_DB_POOL_MAX=10
CONTROL_DB_TIMEOUT_MS=10000

# Alternative full connection string (if provided, overrides separate host/port parameters)
# CONTROL_DATABASE_URL=postgresql://postgres:password@localhost:5432/student_care_control?sslmode=disable

# ------------------------------------------------------------------------------
# 3. School Tenant Database Routing Configuration
# ------------------------------------------------------------------------------
# In Student Care, each school operates on its own dedicated PostgreSQL database.
# In development, school databases can reside on the local PostgreSQL cluster under
# standardized database naming conventions (e.g. 'sc_tenant_<school_id>').
SCHOOL_DB_HOST_DEFAULT=localhost
SCHOOL_DB_PORT_DEFAULT=5432
SCHOOL_DB_USER_DEFAULT=postgres
SCHOOL_DB_PASSWORD_DEFAULT=your_local_school_db_password
SCHOOL_DB_SSL_DEFAULT=false
SCHOOL_DB_POOL_MAX_PER_TENANT=5
SCHOOL_DB_IDLE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 4. Authentication & Security (Future Phase Placeholders)
# ------------------------------------------------------------------------------
# Required when authentication and JWT issuance are integrated.
JWT_SECRET=replace_with_a_secure_random_string_in_local_env_at_least_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=replace_with_a_different_secure_random_string_in_local_env
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 5. Client Application URLs & CORS Allowed Origins
# ------------------------------------------------------------------------------
WEB_APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://localhost:8081
