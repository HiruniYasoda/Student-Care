  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@student-care/shared-types": ["packages/shared-types/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
